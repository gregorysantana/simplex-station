# Copia a .env y completa.

# Simplex
SIMPLEX_URL=https://simplex.do
STATION_TOKEN=pega-aqui-el-token-de-estacion

# Cámara (índice de OpenCV; 0 = la primera)
CAMERA_INDEX=0

# IA de lectura de etiqueta. Modo: gemini | openai | claude | offline
AI_MODE=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Balanza PS60 (USB HID). Déjalo vacío para autodetectar; o fija vendor/product (hex).
SCALE_VENDOR_ID=
SCALE_PRODUCT_ID=

# Impresora de etiqueta (nombre en el SO; vacío = impresora por defecto)
LABEL_PRINTER=

# Puerto local de la app
PORT=8777
